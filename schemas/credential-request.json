{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2zsoc.com/schemas/credential-request.json",
  "title": "Credential broker request",
  "type": "object",
  "required": ["request_id", "tenant_id", "target", "capability", "environment"],
  "additionalProperties": false,
  "properties": {
    "request_id": {"type": "string", "format": "uuid"},
    "tenant_id": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "capability": {"type": "string", "minLength": 1},
    "environment": {"enum": ["lab", "development", "staging", "production", "regulated"]}
  }
}
