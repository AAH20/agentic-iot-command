{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2zsoc.com/schemas/drift-event.json",
  "title": "Tenant-scoped drift event",
  "type": "object",
  "required": ["event_id", "tenant_id", "resource_id", "desired_hash", "observed_hash", "drifted", "changed_fields", "severity", "execution_permitted"],
  "additionalProperties": false,
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "tenant_id": {"type": "string", "minLength": 1},
    "resource_id": {"type": "string", "minLength": 1},
    "desired_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "observed_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "drifted": {"type": "boolean"},
    "changed_fields": {"type": "array", "items": {"type": "string"}},
    "severity": {"enum": ["none", "medium"]},
    "execution_permitted": {"const": false}
  }
}
