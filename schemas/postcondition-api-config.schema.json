{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2z.example/schemas/postcondition-api-config.schema.json",
  "title": "A2Z Postcondition API Service Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "database_path",
    "verifier_registry_path",
    "verifier_trust_directory",
    "tls_certificate",
    "tls_private_key",
    "client_ca",
    "bind_address",
    "port"
  ],
  "properties": {
    "schema_version": {"const": "a2z-postcondition-api-config-v1"},
    "database_path": {"type": "string", "pattern": "^/[^\u0000]+$"},
    "verifier_registry_path": {"type": "string", "pattern": "^/[^\u0000]+$"},
    "verifier_trust_directory": {"type": "string", "pattern": "^/[^\u0000]+$"},
    "tls_certificate": {"type": "string", "pattern": "^/[^\u0000]+$"},
    "tls_private_key": {"type": "string", "pattern": "^/[^\u0000]+$"},
    "client_ca": {"type": "string", "pattern": "^/[^\u0000]+$"},
    "bind_address": {"enum": ["127.0.0.1", "::1"]},
    "port": {"type": "integer", "minimum": 1, "maximum": 65535}
  }
}
