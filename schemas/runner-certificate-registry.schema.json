{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2z.example/schemas/runner-certificate-registry.schema.json",
  "title": "A2Z mTLS runner certificate scope registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identities"],
  "properties": {
    "schema_version": { "const": "a2z-runner-certificate-registry-v1" },
    "identities": {
      "type": "array", "minItems": 1, "maxItems": 500,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["spiffe_id", "tenant_id", "runner_id", "certificate_sha256", "target_ids", "operation_ids", "environments"],
        "properties": {
          "spiffe_id": { "type": "string", "pattern": "^spiffe://[^\\s]+$", "maxLength": 512 },
          "tenant_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" },
          "runner_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" },
          "certificate_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "target_ids": { "type": "array", "minItems": 1, "maxItems": 500, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512, "not": { "const": "*" } } },
          "operation_ids": { "type": "array", "minItems": 1, "maxItems": 500, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" } },
          "environments": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["lab", "development", "staging"] } }
        }
      }
    }
  }
}
